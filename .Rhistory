aes(y = Diameter,
color = ifelse(Diameter != get(CorCol), 'Initial', 'Conserved')),
shape = "circle", size = 3.9) +
geom_line(data = subset(DataCor, !is.na(Diameter)),
aes(y = Diameter,
color = ifelse(Diameter != get(CorCol), 'Initial', 'Conserved'))) +
