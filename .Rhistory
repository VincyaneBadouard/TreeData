# To display the plots in the Rstudio session:
RecruitmentCorrectionPlot(Data,
OnlyCorrected = TRUE,
CorCol = "Diameter_TreeDataCor",
SeveralWindows = TRUE)
library(data.table)
data(TestData)
setnames(TestData, "Diameter", "Diameter_TreeDataCor")
Rslt <- RecruitmentCorrection(TestData,
InvariantColumns = c("Site",
"Genus",
"Species",
"Family",
"ScientificName"))
RecruitmentCorrectionPlot(Rslt, OnlyCorrected = TRUE)
View(Rslt)
Data=Rslt
# Data ---------------------------------------------------------------------------------------------------------------
if(!inherits(Data, c("data.table", "data.frame")))
stop("Data must be a data.frame or data.table")
# IdStem or IdTree? ---------------------------------------------------------------------------------------
# If no IdStem take IdTree
if((!"IdStem" %in% names(Data) | all(is.na(Data$IdStem))) &
("IdTree" %in% names(Data) & any(!is.na(Data$IdTree))) ){ ID <- "IdTree"
}else{ ID <- "IdStem"}
if(!any(c("IdStem", "IdTree") %in% names(Data)) | (all(is.na(Data$IdStem)) &  all(is.na(Data$IdTree))) )
stop("The 'IdStem' or 'IdTree' column is missing in your dataset")
# POM or HOM? ----------------------------------------------------------------------------------------------------------
# If no HOM take POM
if((!"HOM" %in% names(Data) | all(is.na(Data$HOM))) &
("POM" %in% names(Data) & any(!is.na(Data$POM))) ){ POMv <- "POM"
}else{ POMv <- "HOM"}
if((!"HOM_TreeDataCor" %in% names(Data) | all(is.na(Data$HOM_TreeDataCor))) &
("POM_TreeDataCor" %in% names(Data) & any(!is.na(Data$POM_TreeDataCor))) ){ POMcorv <- "POM_TreeDataCor"
}else{ POMcorv <- "HOM_TreeDataCor"}
# Columns --------------------------------------------------------------------------------------------------------------
# IdStem, Year, Diameter, CorrectedRecruit, DBHCor
if(!all(c("Year", "Diameter", "CorrectedRecruit", CorCol) %in% names(Data)))
stop(paste0("'Year', 'Diameter', 'CorrectedRecruit', '",CorCol," should be columns of Data"))
CorCol = "Diameter_TreeDataCor"
# Columns --------------------------------------------------------------------------------------------------------------
# IdStem, Year, Diameter, CorrectedRecruit, DBHCor
if(!all(c("Year", "Diameter", "CorrectedRecruit", CorCol) %in% names(Data)))
stop(paste0("'Year', 'Diameter', 'CorrectedRecruit', '",CorCol," should be columns of Data"))
!"Year" %in% names(Data)
!"CorrectedRecruit" %in% names(Data)
!CorCol %in% names(Data)
if(!"Year" %in% names(Data))
stop(paste0("'Year' should be a column of Data"))
if(!"CorrectedRecruit" %in% names(Data))
stop(paste0("'CorrectedRecruit' should be a column of Data"))
if(!CorCol %in% names(Data))
stop(paste0(CorCol," should be a column of Data"))
!all(c("Year", "CorrectedRecruit", CorCol) %in% names(Data))
library(data.table)
data(TestData)
setnames(TestData, "Diameter", "Diameter_TreeDataCor")
Rslt <- RecruitmentCorrection(TestData,
InvariantColumns = c("Site",
"Genus",
"Species",
"Family",
"ScientificName"))
RecruitmentCorrectionPlot(Data=Rslt, OnlyCorrected = TRUE)
ggplot(Data, aes(x=Diameter_TreeDataCor)) +
theme_minimal() +
geom_histogram(binwidth=1, fill="#69b3a2", color="#e9ecef", alpha=0.9) +
labs(title='DBH distribution of the stand',
y= 'Number of individuals', x='Diameter at Breast Height (cm)')
ggplot(Data, aes(x=TreeHeight)) +
theme_minimal() +
geom_histogram(binwidth=1, fill="#69b3a2", color="#e9ecef", alpha=0.9) +
labs(title='Tree height distribution of the stand',
y= 'Number of individuals', x='Tree height (m)')
